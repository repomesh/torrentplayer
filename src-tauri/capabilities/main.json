{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least-privilege permissions for the main window. Grant each new command explicitly; never add broad `*:default` sets without review.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "allow-app-info",
    "allow-add-torrent-link",
    "allow-add-torrent-file",
    "allow-start-stream",
    "allow-report-playback",
    "allow-record-player-metric",
    "allow-stream-stats",
    "allow-stream-audio",
    "allow-convert-audio",
    "allow-stream-subtitles",
    "allow-load-subtitles",
    "allow-parse-subtitles",
    "allow-stop-stream",
    "allow-dev-autoplay",
    "allow-search-torrents",
    "allow-search-torrents-progressive",
    "allow-cancel-search",
    "allow-prefetch-torrents",
    "allow-fetch-thumbnails",
    "allow-preview-frame",
    "allow-torrent-details",
    "allow-open-link",
    "allow-preload-status",
    "allow-load-queue",
    "allow-save-queue",
    "allow-preload-next",
    "allow-queue-readiness",
    "allow-queue-downloads",
    "allow-file-save-status",
    "allow-link-use",
    "allow-library-items",
    "allow-remove-library-torrent",
    "allow-preview-file",
    "allow-stop-preview",
    "allow-seek-thumbnail",
    "allow-media-tools",
    "allow-choose-ffmpeg-dir",
    "allow-get-settings",
    "allow-update-settings",
    "allow-set-secret",
    "allow-clear-secret",
    "allow-secret-status",
    "allow-cache-usage",
    "allow-clear-cache",
    "allow-choose-download-dir",
    "allow-network-status",
    "allow-recheck-network",
    "allow-validate-wireguard-config",
    "allow-import-wireguard-config",
    "allow-check-connection",
    "allow-public-ip",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
