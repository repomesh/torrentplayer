{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TorrentPlayer",
  "identifier": "io.torrentplayer.desktop",
  "mainBinaryName": "TorrentPlayer",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TorrentPlayer",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "backgroundColor": "#0b0b0f",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:*",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:* ws://localhost:5173",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Stream at the speed of the swarm.",
    "longDescription": "TorrentPlayer streams any torrent, video or audio, straight from the swarm: it starts in seconds and skips to any moment almost instantly, with no servers, accounts, or limits.",
    "copyright": "Copyright (c) 2026 The TorrentPlayer Contributors",
    "license": "MIT OR Apache-2.0",
    "homepage": "https://torrentplayer.io",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": ["gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good"],
        "recommends": ["gstreamer1.0-libav"]
      },
      "rpm": {
        "depends": ["gstreamer1-plugins-base", "gstreamer1-plugins-good"],
        "recommends": ["gstreamer1-plugin-libav"]
      }
    }
  }
}
